{
  "name": "jain-maitri-fullstack",
  "version": "2.0.0",
  "description": "Jain Maitri - Full Stack Matrimonial Application",
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "install:all": "cd client && npm install && cd ../server && npm install",
    "dev": "echo 'Open 2 terminals: Terminal 1: npm run client | Terminal 2: npm run server'",
    "build:client": "cd client && npm run build",
    "start:server": "cd server && npm start",
    "test": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "matrimonial",
    "react",
    "nodejs",
    "firebase"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "client/src/**/*.{js,jsx}",
      "server/**/*.js",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/build/**"
    ],
    "testMatch": [
      "**/tasks/**/task_tests.js",
      "**/tasks/**/task_tests.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/build/"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2"
  }
}
